        "jsCode": "// Odpowiedź Claude to lista bloków (np. 'thinking', potem 'text').\n// Bierzemy blok typu 'text' — to w nim jest nasz JSON.\nconst blok = $json.content.find(b => b.type === 'text');\n\n// Czasem model owija JSON w ```json ... ``` — usuwamy to\nconst tekst = blok.text.replace(/```json|```/g, '').trim();\nconst wynik = JSON.parse(tekst);\n\nreturn {\n  json: {\n    id: $('Tylko nowe').item.json.id,   // id wiersza z wcześniejszego węzła\n    sentyment: wynik.sentyment,\n    kategoria: wynik.kategoria,\n    odpowiedz: wynik.odpowiedz,\n    status: 'gotowe'\n  }\n};"
